# Puerto público. Railway inyecta PORT solo.
PORT=8080

# Volumen donde viven los GGUF. En Docker ya es /data.
DATA_DIR=/data

# 9 GB en bytes decimales, el mismo criterio que Hugging Face.
MAX_MODEL_BYTES=9000000000

# Descarga Qwen 3.5 2B Q4_K_M (1.40 GB, sha256 comprobado) la primera vez
# que arranca y lo deja cargado en memoria (PRELOAD_DEFAULT=1).
AUTO_DOWNLOAD_DEFAULT=1
PRELOAD_DEFAULT=1
DEFAULT_REPO=bartowski/Qwen_Qwen3.5-2B-GGUF
DEFAULT_FILE=Qwen_Qwen3.5-2B-Q4_K_M.gguf
# Solo si cambias DEFAULT_FILE y quieres comprobar otro sha256.
DEFAULT_SHA256=

# Contexto corto: menos RAM y respuestas más rápidas en CPU.
CTX_SIZE=2048
MAX_LOADED_MODELS=1
N_GPU_LAYERS=0
# 0 = automático (respeta la cuota de CPU del contenedor).
LLAMA_THREADS=0
# 1 duplica la RAM de los pesos a cambio de algo más de velocidad al leer el prompt.
LLAMA_REPACK=0
# Caché de prompts de llama-server en MiB (su valor por defecto es 8192).
CACHE_RAM_MIB=0

# Tiempos máximos (segundos). El chat enseña un error en vez de quedarse mudo.
LOAD_TIMEOUT=600
GENERATION_TIMEOUT=180
STREAM_IDLE_TIMEOUT=90
# Rechaza cargar un modelo que no cabe en la RAM del contenedor. 0 para forzarlo.
RAM_CHECK=1
MALLOC_ARENA_MAX=2

# Secreto maestro (recomendado). Es el único secreto obligatorio si el puerto
# queda expuesto: con él se entra al panel y se firman sesiones y API keys.
# Cambiarlo invalida todas las sesiones y API keys. Genera uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Vacío = modo local abierto (el panel lo avisa).
MASTER_SECRET=
# Horas que dura una sesión del panel.
SESSION_TTL_HOURS=12

# Claves fijas antiguas. Siguen funcionando, también junto a MASTER_SECRET.
API_KEY=
ADMIN_TOKEN=
HF_TOKEN=
