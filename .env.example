# Puerto público. Railway inyecta PORT solo.
PORT=8080

# Volumen donde viven los GGUF. En Docker ya es /data.
DATA_DIR=/data

# 9 GB en bytes decimales, el mismo criterio que Hugging Face.
MAX_MODEL_BYTES=9000000000

# Descarga Qwen 3.5 9B Q4_K_M (6.17 GB) la primera vez que arranca.
AUTO_DOWNLOAD_DEFAULT=1
DEFAULT_REPO=bartowski/Qwen_Qwen3.5-9B-GGUF
DEFAULT_FILE=Qwen_Qwen3.5-9B-Q4_K_M.gguf

# Contexto corto para que el 9B quepa en máquinas de 16 GB.
CTX_SIZE=2048
MAX_LOADED_MODELS=1
N_GPU_LAYERS=0
LLAMA_THREADS=0
LOAD_TIMEOUT=1200

# Déjalas vacías en local. Rellénalas si el puerto queda expuesto.
API_KEY=
ADMIN_TOKEN=
HF_TOKEN=
